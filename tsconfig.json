{
  "compilerOptions": {
    "outDir": "./built",
    "rootDir": "./src",
    "skipLibCheck": true,
    "allowJs": true,
    "target": "es2015",
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*"]
}
